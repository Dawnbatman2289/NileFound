rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Block all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Auth + Email Verification requirement
    function isConfiguredAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/config/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && (
          request.auth.token.email.matches('^[^@]+@nileuniversity\\.edu\\.ng$')
          || isConfiguredAdmin()
        );
    }

    // Master Admin check (Sole user permitted to provision admin and security roles)
    function isMasterAdmin() {
      return isConfiguredAdmin();
    }

    // Check roles document in /roles/{uid}
    function hasRole(roleName) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == roleName;
    }

    function isAdmin() {
      return isMasterAdmin() || hasRole('admin');
    }

    function isSecurity() {
      return hasRole('security');
    }

    function isStaffOrAdmin() {
      return isAdmin() || isSecurity();
    }

    // Item schema and field validation
    function isValidItem(data) {
      return data.keys().hasAll(['title', 'type', 'category', 'description', 'location', 'status', 'holdingLocation', 'authorId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.type in ['lost', 'found']
        && data.category in ['student_id', 'phone_tech', 'power_bank', 'calculator', 'flash_drive', 'keys', 'bag_backpack', 'lab_coat_clothing', 'books_notes', 'other']
        && data.description is string && data.description.size() <= 1000
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 100
        && (!('locationDetails' in data) || (data.locationDetails is string && data.locationDetails.size() <= 160))
        && data.status in ['open', 'claim_requested', 'verified', 'returned', 'expired']
        && data.holdingLocation in ['finder_holding', 'security_main_gate', 'student_affairs_office', 'faculty_officer', 'library_desk']
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && (!('imageUrl' in data) || (data.imageUrl is string && (data.imageUrl.matches('^https://kempt-coyote-nc70r\\.firebasestorage\\.app/.*') || data.imageUrl.matches('^data:image/(jpeg|png|webp);base64,.*')) && data.imageUrl.size() <= 100000))
        && (!('verificationQuestion' in data) || (data.verificationQuestion is string && data.verificationQuestion.size() <= 300))
        && (!('isSensitiveId' in data) || (data.isSensitiveId is bool));
    }

    function isValidItemSecret(data, itemId) {
      return data.keys().hasAll(['itemId', 'authorId', 'expectedAnswer', 'createdAt'])
        && data.itemId is string && data.itemId == itemId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.expectedAnswer is string && data.expectedAnswer.size() >= 1 && data.expectedAnswer.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidClaim(data) {
      return data.keys().hasAll(['itemId', 'itemTitle', 'claimantId', 'finderId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['itemId', 'itemTitle', 'claimantId', 'status', 'createdAt', 'updatedAt', 'finderId'])
        && data.itemId is string && data.itemId.size() <= 128
        && data.itemTitle is string && data.itemTitle.size() <= 100
        && data.claimantId is string && data.claimantId.size() <= 128
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50
        && data.finderId is string && data.finderId.size() <= 128;
    }

    function isValidPrivateClaim(data, itemId, claimId) {
      return data.keys().hasOnly(['itemId', 'claimId', 'claimantId', 'claimantName', 'claimantEmail', 'submittedAnswer', 'createdAt'])
        && data.itemId == itemId
        && data.claimId == claimId
        && data.claimantId == request.auth.uid
        && data.claimantName is string && data.claimantName.size() >= 2 && data.claimantName.size() <= 100
        && data.claimantEmail is string && data.claimantEmail.size() >= 3 && data.claimantEmail.size() <= 100
        && data.submittedAnswer is string && data.submittedAnswer.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidPrivateDetails(data, itemId) {
      return data.keys().hasOnly(['itemId', 'authorId', 'authorName', 'authorEmail', 'createdAt'])
        && data.itemId is string && data.itemId == itemId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role in ['student', 'security', 'admin']
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && (!('matricNumber' in data) || (data.matricNumber is string && data.matricNumber.size() <= 20));
    }

    // Items collection (verified campus members only)
    match /items/{itemId} {
      allow get, list: if isVerifiedUser() && isValidId(itemId);
      allow create: if isValidId(itemId) && isVerifiedUser()
        && isValidItem(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open';
      allow update: if isValidId(itemId) && isVerifiedUser()
        && isValidItem(incoming())
        && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid
            && incoming().authorId == existing().authorId
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existing().status != 'returned'
            && incoming().status in ['open', 'claim_requested', 'returned', 'expired']
          )
          || (
            existing().status == 'open'
            && incoming().status == 'claim_requested'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(itemId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().authorId == request.auth.uid)
      );

      // Private secret verification answer subcollection (Only author and admin can read)
      match /secrets/{secretId} {
        allow get: if isValidId(secretId) && isVerifiedUser() && (
          isAdmin() ||
          resource.data.authorId == request.auth.uid
        );
        allow list: if isAdmin();
        allow create: if isValidId(secretId) && isVerifiedUser()
          && isValidItemSecret(incoming(), itemId);
        allow update, delete: if isValidId(secretId) && (
          isAdmin() ||
          (isVerifiedUser() && resource.data.authorId == request.auth.uid)
        );
      }

      // Private reporter details subcollection (Only item owner and admin can read)
      match /private/{docId} {
        allow get: if isValidId(docId) && isVerifiedUser() && (
          isMasterAdmin() ||
          isAdmin() ||
          resource.data.authorId == request.auth.uid
        );
        allow list: if isMasterAdmin() || isAdmin();
        allow create: if isValidId(docId) && isVerifiedUser()
          && isValidPrivateDetails(incoming(), itemId);
        allow update, delete: if isValidId(docId) && (
          isMasterAdmin() ||
          isAdmin() ||
          (isVerifiedUser() && resource.data.authorId == request.auth.uid)
        );

      }

      match /privateClaims/{claimId} {
        allow get: if isValidId(claimId) && isVerifiedUser() && (
          isAdmin() ||
          resource.data.claimantId == request.auth.uid ||
          get(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid
        );
        allow list: if isVerifiedUser() && (
          isAdmin() ||
          get(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid
        );
        allow create: if isValidId(claimId) && isVerifiedUser()
          && isValidPrivateClaim(incoming(), itemId, claimId);
        allow update, delete: if isValidId(claimId) && isAdmin();
      }
    }

    // Claims collection
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && isVerifiedUser() && (
        isAdmin() || resource.data.claimantId == request.auth.uid
      );
      allow list: if isVerifiedUser() && (
        isAdmin() || resource.data.claimantId == request.auth.uid
      );
      allow create: if isValidId(claimId) && isVerifiedUser()
        && isValidClaim(incoming())
        && incoming().claimantId == request.auth.uid
        && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/items/$(incoming().itemId))
        && incoming().finderId == get(/databases/$(database)/documents/items/$(incoming().itemId)).data.authorId;
      allow update: if isValidId(claimId) && isVerifiedUser()
        && isValidClaim(incoming())
        && incoming().claimantId == existing().claimantId
        && incoming().itemId == existing().itemId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            resource.data.finderId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['pending', 'approved', 'rejected']
          )
        );
      allow delete: if isValidId(claimId) && isAdmin();
    }

    // Role assignment collection (/roles/{userId})
    // Strictly restricted to the project owner's UID.
    match /roles/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isMasterAdmin();
    }

    // Bootstrap this document once in the Firebase console. It is not writable by clients.
    match /config/admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Users directory
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && (incoming().role == 'student' || isMasterAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Campus and Admin Notifications
    function isValidNotification(data) {
      return data.keys().hasAll(['recipientUid', 'fromUid', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientUid', 'fromUid', 'type', 'title', 'message', 'read', 'createdAt', 'itemId', 'claimId'])
        && data.fromUid is string && data.fromUid == request.auth.uid
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128
        && data.type in ['claim_received', 'claim_approved', 'claim_rejected', 'match_alert', 'item_returned', 'admin_review']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && !data.title.matches('.*@.*')
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && !data.message.matches('.*@.*')
        && data.read is bool && data.read == false
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('itemId' in data) || (data.itemId is string && data.itemId.size() <= 128))
        && (!('itemTitle' in data) || (data.itemTitle is string && data.itemTitle.size() <= 100 && !data.itemTitle.matches('.*@.*')))
        && (!('claimId' in data) || (data.claimId is string && data.claimId.size() <= 128))
        && (
          (data.type == 'claim_received' && data.title == 'New claim on your item' && data.message == 'A new ownership claim was filed for your item.')
          || (data.type == 'claim_approved' && data.title == 'Claim approved' && data.message == 'Your ownership claim was approved.')
          || (data.type == 'claim_rejected' && data.title == 'Claim rejected' && data.message == 'Your ownership claim was rejected.')
          || (data.type == 'match_alert' && data.title == 'Possible item match' && data.message == 'A possible match was found for your report.')
          || (data.type == 'item_returned' && data.title == 'Item returned' && data.message == 'Your reported item was marked returned.')
          || (data.type == 'admin_review' && data.title == 'Review needed' && data.message == 'A campus record needs administrator review.')
        );
    }

    function canCreateNotification(data) {
      return data.recipientUid == request.auth.uid
        || (
          data.recipientUid == 'admin'
          && data.type == 'admin_review'
          && (
            (
              'itemId' in data
              && exists(/databases/$(database)/documents/items/$(data.itemId))
              && get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == request.auth.uid
            )
            || (
              'claimId' in data
              && exists(/databases/$(database)/documents/claims/$(data.claimId))
              && get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId == request.auth.uid
            )
          )
        )
        || (
          'itemId' in data
          && exists(/databases/$(database)/documents/items/$(data.itemId))
          && get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == data.recipientUid
          && data.type in ['claim_received', 'item_returned', 'match_alert']
        )
        || (
          'claimId' in data
          && exists(/databases/$(database)/documents/claims/$(data.claimId))
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId == data.recipientUid
          && data.type in ['claim_approved', 'claim_rejected']
        );
    }

    match /notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && (
        resource.data.recipientUid == request.auth.uid ||
        (isAdmin() && resource.data.recipientUid == 'admin')
      );
      allow create: if isValidId(notificationId) && isVerifiedUser()
        && isValidNotification(incoming())
        && canCreateNotification(incoming());
      allow update: if isValidId(notificationId) && isVerifiedUser()
        && (resource.data.recipientUid == request.auth.uid || (isAdmin() && resource.data.recipientUid == 'admin'))
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read is bool;
      allow delete: if isValidId(notificationId) && (
        isAdmin() ||
        (isVerifiedUser() && resource.data.recipientUid == request.auth.uid)
      );
    }
  }
}
