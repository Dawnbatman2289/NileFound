rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Explicit default-deny sentinel; Firestore rules are additive so unmatched paths remain denied.
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Root project owner identity by Firebase Auth UID (update UID if self-hosting a different Firebase project)
    function isMasterAdmin() {
      return request.auth != null
        && request.auth.uid == 'nFdIhTjOOqMqMG4y1KIT550Qf5m1'
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    // Delegated admin flag in /admins/{uid} (does NOT grant master admin privileges)
    function isConfiguredAdmin() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function isVerifiedUser() {
      return isMasterAdmin()
        || (
          request.auth != null
          && request.auth.token.keys().hasAll(['email_verified'])
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && (
            request.auth.token.email.lower().matches('^[^@\\s]+@nileuniversity\\.edu\\.ng$')
            || isConfiguredAdmin()
          )
        );
    }

    // Check roles document in /roles/{uid} first; fall back to /staffInvites/{email} only when no explicit role doc exists
    function hasRole(roleName) {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == roleName
          : (
            request.auth.token.email is string
            && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower()))
            && get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower())).data.role == roleName
          )
      );
    }

    function isAdmin() {
      return isMasterAdmin() || isConfiguredAdmin() || hasRole('admin');
    }

    function isSecurity() {
      return hasRole('security');
    }

    function isStaffOrAdmin() {
      return isAdmin() || isSecurity();
    }

    // Item schema and field validation (no PII, no legacy imageUrl, and no photos for student_id)
    function isValidItem(data) {
      return data.keys().hasAll(['title', 'type', 'category', 'description', 'location', 'status', 'holdingLocation', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'type', 'category', 'description', 'location', 'locationDetails', 'dateLostOrFound', 'status', 'holdingLocation', 'custodyStatus', 'authorId', 'thumbUrl', 'isSensitiveId', 'verificationQuestion', 'createdAt', 'updatedAt'])
        && !('imageUrl' in data)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.type in ['lost', 'found']
        && data.category in ['student_id', 'phone_tech', 'power_bank', 'calculator', 'flash_drive', 'keys', 'bag_backpack', 'lab_coat_clothing', 'books_notes', 'other']
        && data.description is string && data.description.size() <= 1000
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 100
        && (!('locationDetails' in data) || (data.locationDetails is string && data.locationDetails.size() <= 160))
        && (!('dateLostOrFound' in data) || (data.dateLostOrFound is string && data.dateLostOrFound.size() <= 40))
        && data.status in ['open', 'claim_requested', 'verified', 'returned', 'expired']
        && data.holdingLocation in ['finder_holding', 'security_main_gate', 'student_affairs_office', 'faculty_officer', 'library_desk']
        && (!('custodyStatus' in data) || data.custodyStatus in ['awaiting_dropoff', 'confirmed'])
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && !(data.category == 'student_id' && 'thumbUrl' in data)
        && (data.category != 'student_id' || data.isSensitiveId == true)
        && (!('thumbUrl' in data) || (
          data.thumbUrl is string
          && data.thumbUrl.size() <= 4200
          && data.thumbUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        ))
        && (!('verificationQuestion' in data) || (data.verificationQuestion is string && data.verificationQuestion.size() <= 300))
        && (!('isSensitiveId' in data) || (data.isSensitiveId is bool));
    }

    function isValidItemMedia(data, itemId) {
      return data.keys().hasAll(['itemId', 'authorId', 'dataUrl', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'authorId', 'dataUrl', 'createdAt'])
        && data.itemId is string && data.itemId == itemId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.dataUrl is string
        && data.dataUrl.size() <= 140000
        && data.dataUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        && data.createdAt is timestamp;
    }

    function isValidItemSecret(data, itemId) {
      return data.keys().hasAll(['itemId', 'authorId', 'expectedAnswer', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'authorId', 'expectedAnswer', 'createdAt'])
        && data.itemId is string && data.itemId == itemId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.expectedAnswer is string && data.expectedAnswer.size() >= 1 && data.expectedAnswer.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidClaim(data) {
      return data.keys().hasAll(['itemId', 'itemTitle', 'claimantId', 'finderId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['itemId', 'itemTitle', 'claimantId', 'finderId', 'status', 'resubmitted', 'createdAt', 'updatedAt'])
        && data.itemId is string && data.itemId.size() <= 128
        && data.itemTitle is string && data.itemTitle.size() <= 100
        && data.claimantId is string && data.claimantId.size() <= 128
        && data.finderId is string && data.finderId.size() <= 128
        && data.status in ['pending', 'approved', 'rejected']
        && (!('resubmitted' in data) || (data.resubmitted is bool))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateClaim(data, itemId, claimId) {
      return data.keys().hasAll(['itemId', 'claimId', 'claimantId', 'claimantName', 'claimantEmail', 'submittedAnswer', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'claimId', 'claimantId', 'claimantName', 'claimantEmail', 'submittedAnswer', 'createdAt', 'updatedAt'])
        && data.itemId == itemId
        && data.claimId == claimId
        && data.claimantId == request.auth.uid
        && data.claimantName is string && data.claimantName.size() >= 2 && data.claimantName.size() <= 100
        && data.claimantEmail is string && data.claimantEmail.size() >= 3 && data.claimantEmail.size() <= 100
        && data.submittedAnswer is string && data.submittedAnswer.size() <= 500
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidPrivateDetails(data, itemId) {
      return data.keys().hasAll(['itemId', 'authorId', 'authorName', 'authorEmail', 'createdAt'])
        && data.keys().hasOnly(['itemId', 'authorId', 'authorName', 'authorEmail', 'createdAt'])
        && data.itemId is string && data.itemId == itemId
        && data.authorId is string && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'role', 'department', 'matricNumber', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && request.auth.token.email is string && (data.email == request.auth.token.email || data.email == request.auth.token.email.lower())
        && data.role == 'student'
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || (data.updatedAt is timestamp))
        && (!('department' in data) || (data.department is string && data.department.size() <= 100))
        && (!('matricNumber' in data) || (data.matricNumber is string && data.matricNumber.size() <= 20));
    }

    // Items collection (verified campus members only)
    match /items/{itemId} {
      allow get: if isVerifiedUser() && isValidId(itemId);
      allow list: if isVerifiedUser() && request.query.limit <= 50;
      allow create: if isValidId(itemId) && isVerifiedUser()
        && isValidItem(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open'
        && (
          !('custodyStatus' in incoming())
            ? (incoming().type != 'found' || incoming().holdingLocation == 'finder_holding' || isStaffOrAdmin())
            : (
              incoming().custodyStatus in ['awaiting_dropoff', 'confirmed']
              && (
                incoming().custodyStatus != 'confirmed'
                || isStaffOrAdmin()
                || incoming().type != 'found'
                || incoming().holdingLocation == 'finder_holding'
              )
            )
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isVerifiedUser()
        && isValidItem(incoming())
        // Enforce immutable reporter identity (authorId) and createdAt post-creation
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isSecurity()
            && existing().holdingLocation != 'finder_holding'
            && (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['custodyStatus', 'updatedAt'])
                && (!('custodyStatus' in existing()) || existing().custodyStatus == 'awaiting_dropoff')
                && incoming().custodyStatus == 'confirmed'
              )
              || (
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                && (
                  (existing().status == 'verified' && incoming().status == 'returned')
                  || (existing().status in ['open', 'claim_requested'] && incoming().status == 'verified')
                )
              )
            )
          )
          || (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existing().status != 'returned'
            && incoming().status in ['open', 'claim_requested', 'verified', 'returned', 'expired']
          )
          || (
            existing().status in ['open', 'claim_requested']
            && existing().type == 'found'
            && existing().authorId != request.auth.uid
            && (!('custodyStatus' in existing()) || existing().custodyStatus != 'awaiting_dropoff')
            && incoming().status == 'claim_requested'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/claims/$(itemId + '_' + request.auth.uid))
          )
        );
      allow delete: if isValidId(itemId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().authorId == request.auth.uid)
      );

      // Guard nested /items/{itemId}/claims/{claimId} if ever queried directly: claimant or admin only
      match /claims/{nestedClaimId} {
        allow get: if isValidId(itemId) && isValidId(nestedClaimId) && isVerifiedUser()
          && (isAdmin() || resource.data.claimantId == request.auth.uid);
        allow list: if isValidId(itemId) && isVerifiedUser() && request.query.limit <= 50
          && (isAdmin() || resource.data.claimantId == request.auth.uid);
        allow write: if false;
      }

      // Private secret verification answer subcollection
      match /secrets/{secretId} {
        allow get: if isValidId(secretId) && isVerifiedUser() && (
          isAdmin()
          || resource.data.authorId == request.auth.uid
          || (
            isSecurity()
            && get(/databases/$(database)/documents/items/$(itemId)).data.holdingLocation != 'finder_holding'
          )
        );
        allow list: if request.query.limit <= 50 && (
          isAdmin()
          || (
            isSecurity()
            && get(/databases/$(database)/documents/items/$(itemId)).data.holdingLocation != 'finder_holding'
          )
        );
        allow create: if isValidId(secretId) && isVerifiedUser()
          && isValidItemSecret(incoming(), itemId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/items/$(itemId))
          && getAfter(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid;
        allow update: if isValidId(secretId) && isVerifiedUser()
          && isValidItemSecret(incoming(), itemId)
          && incoming().createdAt == existing().createdAt
          && (isAdmin() || resource.data.authorId == request.auth.uid);
        allow delete: if isValidId(secretId) && (
          isAdmin() ||
          (isVerifiedUser() && resource.data.authorId == request.auth.uid)
        );
      }

      // Private reporter details subcollection (author, staff/admin, or approved claimant for handover)
      match /private/{docId} {
        allow get: if isValidId(docId) && isVerifiedUser() && (
          isStaffOrAdmin()
          || resource.data.authorId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/claims/$(itemId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/claims/$(itemId + '_' + request.auth.uid)).data.status == 'approved'
          )
        );
        allow list: if isStaffOrAdmin() && request.query.limit <= 50;
        allow create: if isValidId(docId) && isVerifiedUser()
          && isValidPrivateDetails(incoming(), itemId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/items/$(itemId))
          && getAfter(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid;
        allow update: if isValidId(docId) && isVerifiedUser()
          && isValidPrivateDetails(incoming(), itemId)
          && incoming().createdAt == existing().createdAt
          && (isAdmin() || resource.data.authorId == request.auth.uid);
        allow delete: if isValidId(docId) && (
          isAdmin() ||
          (isVerifiedUser() && resource.data.authorId == request.auth.uid)
        );
      }

      // Private claim details (claimant, item author, and campus staff/admin)
      match /privateClaims/{claimId} {
        allow get: if isValidId(claimId) && isVerifiedUser() && (
          isStaffOrAdmin()
          || resource.data.claimantId == request.auth.uid
          || get(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid
        );
        allow list: if isVerifiedUser() && request.query.limit <= 50 && (
          isStaffOrAdmin()
          || get(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid
        );
        allow create: if isValidId(claimId) && isVerifiedUser()
          && isValidPrivateClaim(incoming(), itemId, claimId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/claims/$(claimId))
          && getAfter(/databases/$(database)/documents/claims/$(claimId)).data.claimantId == request.auth.uid
          && getAfter(/databases/$(database)/documents/claims/$(claimId)).data.itemId == itemId;
        allow update: if isValidId(claimId) && (
          isAdmin()
          || (
            isVerifiedUser()
            && isValidPrivateClaim(incoming(), itemId, claimId)
            && resource.data.claimantId == request.auth.uid
            && incoming().claimantId == existing().claimantId
            && incoming().itemId == existing().itemId
            && incoming().claimId == existing().claimId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['submittedAnswer', 'updatedAt'])
            && exists(/databases/$(database)/documents/claims/$(claimId))
            && get(/databases/$(database)/documents/claims/$(claimId)).data.claimantId == request.auth.uid
            && get(/databases/$(database)/documents/claims/$(claimId)).data.status == 'rejected'
            && (!('resubmitted' in get(/databases/$(database)/documents/claims/$(claimId)).data) || get(/databases/$(database)/documents/claims/$(claimId)).data.resubmitted == false)
            && getAfter(/databases/$(database)/documents/claims/$(claimId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/claims/$(claimId)).data.resubmitted == true
          )
        );
        allow delete: if isValidId(claimId) && (
          isAdmin()
          || (isVerifiedUser() && resource.data.claimantId == request.auth.uid)
          || (isVerifiedUser() && get(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid)
        );
      }

      // Full-resolution photo stored outside feed list docs (never for student_id)
      match /media/{mediaId} {
        allow get: if isValidId(itemId) && mediaId == 'full' && isVerifiedUser()
          && exists(/databases/$(database)/documents/items/$(itemId))
          && get(/databases/$(database)/documents/items/$(itemId)).data.category != 'student_id';
        allow list: if false;
        allow create: if isValidId(itemId) && mediaId == 'full' && isVerifiedUser()
          && isValidItemMedia(incoming(), itemId)
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/items/$(itemId))
          && getAfter(/databases/$(database)/documents/items/$(itemId)).data.authorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/items/$(itemId)).data.category != 'student_id';
        allow update: if false;
        allow delete: if isValidId(itemId) && mediaId == 'full' && (
          isAdmin()
          || (isVerifiedUser() && resource.data.authorId == request.auth.uid)
        );
      }
    }

    // Claims collection (deterministic ID: ${itemId}_${claimantUid})
    match /claims/{claimId} {
      allow get: if isValidId(claimId) && isVerifiedUser() && (
        isStaffOrAdmin()
        || resource.data.claimantId == request.auth.uid
        || resource.data.finderId == request.auth.uid
      );
      allow list: if isVerifiedUser() && request.query.limit <= 50 && (
        isStaffOrAdmin()
        || resource.data.claimantId == request.auth.uid
        || resource.data.finderId == request.auth.uid
      );
      allow create: if isValidId(claimId) && isVerifiedUser()
        && isValidClaim(incoming())
        && claimId == incoming().itemId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/claims/$(claimId))
        && incoming().claimantId == request.auth.uid
        && incoming().status == 'pending'
        && (!('resubmitted' in incoming()) || incoming().resubmitted == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/items/$(incoming().itemId))
        && get(/databases/$(database)/documents/items/$(incoming().itemId)).data.type == 'found'
        && get(/databases/$(database)/documents/items/$(incoming().itemId)).data.status in ['open', 'claim_requested']
        && (!('custodyStatus' in get(/databases/$(database)/documents/items/$(incoming().itemId)).data) || get(/databases/$(database)/documents/items/$(incoming().itemId)).data.custodyStatus != 'awaiting_dropoff')
        && get(/databases/$(database)/documents/items/$(incoming().itemId)).data.authorId != request.auth.uid
        && incoming().finderId == get(/databases/$(database)/documents/items/$(incoming().itemId)).data.authorId;
      allow update: if isValidId(claimId) && isVerifiedUser()
        && isValidClaim(incoming())
        && incoming().claimantId == existing().claimantId
        && incoming().finderId == existing().finderId
        && incoming().itemId == existing().itemId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/items/$(existing().itemId))
        && get(/databases/$(database)/documents/items/$(existing().itemId)).data.status != 'returned'
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existing().status == 'pending'
            && incoming().status in ['approved', 'rejected']
            && (
              incoming().status != 'approved'
              || (
                get(/databases/$(database)/documents/items/$(existing().itemId)).data.status in ['open', 'claim_requested']
                && getAfter(/databases/$(database)/documents/items/$(existing().itemId)).data.status == 'verified'
              )
            )
            && (
              isAdmin()
              || resource.data.finderId == request.auth.uid
              || (
                isSecurity()
                && get(/databases/$(database)/documents/items/$(existing().itemId)).data.holdingLocation != 'finder_holding'
              )
            )
          )
          || (
            resource.data.claimantId == request.auth.uid
            && existing().status == 'rejected'
            && (!('resubmitted' in existing()) || existing().resubmitted == false)
            && incoming().status == 'pending'
            && incoming().resubmitted == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resubmitted', 'updatedAt'])
            && get(/databases/$(database)/documents/items/$(existing().itemId)).data.type == 'found'
            && get(/databases/$(database)/documents/items/$(existing().itemId)).data.status in ['open', 'claim_requested']
            && (!('custodyStatus' in get(/databases/$(database)/documents/items/$(existing().itemId)).data) || get(/databases/$(database)/documents/items/$(existing().itemId)).data.custodyStatus != 'awaiting_dropoff')
            && getAfter(/databases/$(database)/documents/items/$(existing().itemId)).data.status == 'claim_requested'
            && existsAfter(/databases/$(database)/documents/items/$(existing().itemId)/privateClaims/$(claimId))
            && getAfter(/databases/$(database)/documents/items/$(existing().itemId)/privateClaims/$(claimId)).data.claimantId == request.auth.uid
            && getAfter(/databases/$(database)/documents/items/$(existing().itemId)/privateClaims/$(claimId)).data.updatedAt == request.time
          )
        );
      allow delete: if isValidId(claimId) && (
        isAdmin() ||
        (isVerifiedUser() && resource.data.finderId == request.auth.uid)
      );

      // Private handover chat messages scoped to the claim's claimant, finder, and authorized staff/admins
      function isValidClaimMessage(data, claimData) {
        return data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt'])
          && data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && data.senderId is string && data.senderId == request.auth.uid
          && data.senderRole in ['Finder', 'Claimant', 'Campus Security', 'Admin']
          && (
            (data.senderRole == 'Claimant' && claimData.claimantId == request.auth.uid)
            || (data.senderRole == 'Finder' && claimData.finderId == request.auth.uid)
            || (data.senderRole == 'Campus Security' && isSecurity())
            || (data.senderRole == 'Admin' && isAdmin())
          )
          && data.text is string && data.text.size() >= 1 && data.text.size() <= 500
          && data.createdAt is timestamp;
      }

      function isClaimChatParticipant(claimData) {
        return claimData.claimantId == request.auth.uid
          || claimData.finderId == request.auth.uid
          || isAdmin()
          || (
            isSecurity()
            && exists(/databases/$(database)/documents/items/$(claimData.itemId))
            && get(/databases/$(database)/documents/items/$(claimData.itemId)).data.holdingLocation != 'finder_holding'
          );
      }

      match /messages/{messageId} {
        allow get: if isValidId(claimId) && isValidId(messageId) && isVerifiedUser()
          && exists(/databases/$(database)/documents/claims/$(claimId))
          && isClaimChatParticipant(get(/databases/$(database)/documents/claims/$(claimId)).data);
        allow list: if isValidId(claimId) && isVerifiedUser() && request.query.limit <= 50
          && exists(/databases/$(database)/documents/claims/$(claimId))
          && isClaimChatParticipant(get(/databases/$(database)/documents/claims/$(claimId)).data);
        allow create: if isValidId(claimId) && isValidId(messageId) && isVerifiedUser()
          && exists(/databases/$(database)/documents/claims/$(claimId))
          && get(/databases/$(database)/documents/claims/$(claimId)).data.status in ['pending', 'approved']
          && exists(/databases/$(database)/documents/items/$(get(/databases/$(database)/documents/claims/$(claimId)).data.itemId))
          && !(get(/databases/$(database)/documents/items/$(get(/databases/$(database)/documents/claims/$(claimId)).data.itemId)).data.status in ['returned', 'expired'])
          && isClaimChatParticipant(get(/databases/$(database)/documents/claims/$(claimId)).data)
          && isValidClaimMessage(incoming(), get(/databases/$(database)/documents/claims/$(claimId)).data)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(claimId) && isValidId(messageId) && (
          isAdmin()
          || (isVerifiedUser() && resource.data.senderId == request.auth.uid)
        );
      }
    }

    // Role assignment collection (/roles/{userId}) - only Master Admin writes
    match /roles/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if isValidId(userId) && isMasterAdmin()
        && incoming().keys().hasAll(['role', 'email', 'assignedAt'])
        && incoming().keys().hasOnly(['role', 'email', 'assignedAt', 'assignedBy', 'updatedAt'])
        && incoming().role in ['admin', 'security', 'staff', 'student']
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().assignedAt is timestamp
        && (!('assignedBy' in incoming()) || (incoming().assignedBy is string && incoming().assignedBy.size() <= 128))
        && (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp));
      allow delete: if isValidId(userId) && isMasterAdmin();
    }

    // Email-keyed pending staff role assignments (/staffInvites/{inviteEmail})
    match /staffInvites/{inviteEmail} {
      allow get: if isVerifiedUser() && (isAdmin() || (request.auth.token.email is string && request.auth.token.email.lower() == inviteEmail));
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create, update: if isMasterAdmin()
        && inviteEmail.size() <= 128
        && inviteEmail == inviteEmail.lower()
        && inviteEmail.matches('^[^/@\\s]+@nileuniversity\\.edu\\.ng$')
        && incoming().keys().hasAll(['email', 'role', 'assignedAt'])
        && incoming().keys().hasOnly(['email', 'role', 'assignedAt', 'assignedBy'])
        && incoming().email == inviteEmail
        && incoming().role in ['admin', 'security', 'staff', 'student']
        && incoming().assignedAt is timestamp
        && incoming().assignedAt == request.time
        && (!('assignedBy' in incoming()) || (incoming().assignedBy is string && incoming().assignedBy.size() <= 128));
      allow delete: if isMasterAdmin();
    }

    // Delegated admins collection (/admins/{adminUid}) - only Master Admin writes
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && request.auth != null
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && (request.auth.uid == adminUid || isMasterAdmin());
      allow list: if isMasterAdmin() && request.query.limit <= 50;
      allow create, update: if isValidId(adminUid) && isMasterAdmin()
        && incoming().keys().hasAll(['enabled', 'email', 'updatedAt'])
        && incoming().keys().hasOnly(['enabled', 'email', 'updatedAt'])
        && incoming().enabled is bool
        && incoming().email is string && incoming().email.size() <= 100
        && incoming().updatedAt is timestamp
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(adminUid) && isMasterAdmin();
    }

    // Users directory
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if isValidId(userId) && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().role == 'student';
      allow update: if isValidId(userId) && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().createdAt == existing().createdAt
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time)
        && incoming().role == existing().role;
      allow delete: if isValidId(userId) && (
        isAdmin() || (isVerifiedUser() && request.auth.uid == userId)
      );
    }

    // Campus and Admin Notifications
    function isValidNotification(data) {
      return data.keys().hasAll(['recipientUid', 'fromUid', 'type', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientUid', 'fromUid', 'type', 'title', 'message', 'read', 'createdAt', 'itemId', 'itemTitle', 'claimId', 'sourceItemId'])
        && data.fromUid is string && data.fromUid == request.auth.uid
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid.size() <= 128
        && data.type in ['claim_received', 'claim_approved', 'claim_rejected', 'chat_message', 'match_alert', 'item_returned', 'custody_confirmed']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && !data.title.matches('.*@.*')
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 500
        && !data.message.matches('.*@.*')
        && data.read is bool && data.read == false
        && data.createdAt is timestamp && data.createdAt == request.time
        && (!('itemId' in data) || (data.itemId is string && data.itemId.size() <= 128))
        && (!('sourceItemId' in data) || (data.sourceItemId is string && data.sourceItemId.size() <= 128))
        && (!('itemTitle' in data) || (data.itemTitle is string && data.itemTitle.size() <= 100 && !data.itemTitle.matches('.*@.*')))
        && (!('claimId' in data) || (data.claimId is string && data.claimId.size() <= 128))
        && (
          (data.type == 'claim_received' && data.title == 'New claim on your item' && data.message == 'A new ownership claim was filed for your item.')
          || (data.type == 'claim_approved' && data.title == 'Claim approved' && data.message == 'Your ownership claim was approved.')
          || (data.type == 'claim_rejected' && data.title == 'Claim rejected' && data.message == 'Your ownership claim was rejected.')
          || (data.type == 'chat_message' && data.title == 'New handover message' && data.message == 'You have a new message in your item handover chat.')
          || (data.type == 'match_alert' && data.title == 'Possible item match' && data.message == 'A possible match was found for your report.')
          || (data.type == 'item_returned' && data.title == 'Item returned' && data.message == 'Your reported item was marked returned.')
          || (data.type == 'custody_confirmed' && data.title == 'Drop-off confirmed' && data.message == 'Campus desk confirmed physical custody of your found item.')
        );
    }

    function canCreateNotification(data) {
      return (data.recipientUid == request.auth.uid && data.type == 'match_alert')
        || (
          data.type == 'claim_received'
          && 'claimId' in data
          && 'itemId' in data
          && exists(/databases/$(database)/documents/claims/$(data.claimId))
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId == request.auth.uid
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.finderId == data.recipientUid
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.itemId == data.itemId
        )
        || (
          data.type == 'item_returned'
          && 'itemId' in data
          && exists(/databases/$(database)/documents/items/$(data.itemId))
          && get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == data.recipientUid
          && (
            isStaffOrAdmin()
            || get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == request.auth.uid
          )
        )
        || (
          data.type == 'custody_confirmed'
          && 'itemId' in data
          && isStaffOrAdmin()
          && exists(/databases/$(database)/documents/items/$(data.itemId))
          && get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == data.recipientUid
          && get(/databases/$(database)/documents/items/$(data.itemId)).data.custodyStatus == 'confirmed'
        )
        || (
          data.type == 'match_alert'
          && 'itemId' in data
          && exists(/databases/$(database)/documents/items/$(data.itemId))
          && get(/databases/$(database)/documents/items/$(data.itemId)).data.authorId == data.recipientUid
          && (
            isStaffOrAdmin()
            || (
              'sourceItemId' in data
              && exists(/databases/$(database)/documents/items/$(data.sourceItemId))
              && get(/databases/$(database)/documents/items/$(data.sourceItemId)).data.authorId == request.auth.uid
            )
          )
        )
        || (
          data.type in ['claim_approved', 'claim_rejected']
          && 'claimId' in data
          && exists(/databases/$(database)/documents/claims/$(data.claimId))
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId == data.recipientUid
          && (
            isStaffOrAdmin()
            || get(/databases/$(database)/documents/claims/$(data.claimId)).data.finderId == request.auth.uid
          )
        )
        || (
          data.type == 'chat_message'
          && 'claimId' in data
          && 'itemId' in data
          && data.recipientUid != request.auth.uid
          && exists(/databases/$(database)/documents/claims/$(data.claimId))
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.itemId == data.itemId
          && get(/databases/$(database)/documents/claims/$(data.claimId)).data.status in ['pending', 'approved']
          && exists(/databases/$(database)/documents/items/$(data.itemId))
          && !(get(/databases/$(database)/documents/items/$(data.itemId)).data.status in ['returned', 'expired'])
          && (
            get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId == request.auth.uid
            || get(/databases/$(database)/documents/claims/$(data.claimId)).data.finderId == request.auth.uid
            || isAdmin()
            || (
              isSecurity()
              && get(/databases/$(database)/documents/items/$(data.itemId)).data.holdingLocation != 'finder_holding'
            )
          )
          && (
            data.recipientUid == get(/databases/$(database)/documents/claims/$(data.claimId)).data.claimantId
            || data.recipientUid == get(/databases/$(database)/documents/claims/$(data.claimId)).data.finderId
            || (
              data.recipientUid == 'admin'
              && get(/databases/$(database)/documents/items/$(data.itemId)).data.holdingLocation != 'finder_holding'
            )
          )
        );
    }

    function isChatNotifId(notificationId, data) {
      return data.type != 'chat_message'
        || ('claimId' in data && notificationId == 'chat_' + data.claimId + '_' + data.recipientUid);
    }

    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() && (
        resource.data.recipientUid == request.auth.uid ||
        (isStaffOrAdmin() && resource.data.recipientUid == 'admin')
      );
      allow list: if isVerifiedUser() && request.query.limit <= 50 && (
        resource.data.recipientUid == request.auth.uid ||
        (isStaffOrAdmin() && resource.data.recipientUid == 'admin')
      );
      allow create: if isValidId(notificationId) && isVerifiedUser()
        && isValidNotification(incoming())
        && isChatNotifId(notificationId, incoming())
        && canCreateNotification(incoming());
      allow update: if isValidId(notificationId) && isVerifiedUser() && (
        (
          (resource.data.recipientUid == request.auth.uid || (isStaffOrAdmin() && resource.data.recipientUid == 'admin'))
          && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
          && incoming().read is bool
        )
        || (
          existing().type == 'chat_message'
          && incoming().type == 'chat_message'
          && incoming().recipientUid == existing().recipientUid
          && incoming().claimId == existing().claimId
          && isChatNotifId(notificationId, incoming())
          && isValidNotification(incoming())
          && canCreateNotification(incoming())
        )
      );
      allow delete: if isValidId(notificationId) && (
        isAdmin() ||
        (isVerifiedUser() && resource.data.recipientUid == request.auth.uid)
      );
    }
  }
}
