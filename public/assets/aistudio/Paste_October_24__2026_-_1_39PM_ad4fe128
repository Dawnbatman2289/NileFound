      const list = document.getElementById('admin-items-list');
      list.innerHTML = '';
      data.forEach(i => {
        list.innerHTML += `
          <div class="p-2 border rounded flex justify-between items-center">
            <div>
              <p class="font-bold">${i.title} (${i.type})</p>
              <p class="text-[10px] text-slate-400">${i.location} | Hidden: ${i.verification || 'None'}</p>
            </div>
            <button onclick="deleteItem('${i.id}')" class="text-red-600 hover:underline">Purge</button>
          </div>
