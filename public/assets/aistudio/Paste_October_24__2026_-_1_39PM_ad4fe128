Step 2: Client-Side Image Compression Module (src/utils/imageCompressor.js)Implement canvas-based client image downscaling prior to upload:JavaScript/**
 * Downscales and compresses an image file using HTML5 Canvas.
 * @param {File} file - Raw image file from file input.
 * @param {number} maxWidth - Maximum allowed width in pixels (default 1024px).
 * @param {number} quality - Compression quality ratio between 0.0 and 1.0 (default 0.7).
 * @returns {Promise<Blob>} Compressed JPEG blob under target size limit.
 */
export async function compressImage(file, maxWidth = 1024, quality = 0.7) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.readAsDataURL(file);
    reader.onload = (event) => {
      const img = new Image();
      img.src = event.target.result;
      img.onload = () => {
        const canvas = document.createElement('canvas');
        let width = img.width;
        let height = img.height;

        if (width > maxWidth) {
          height = Math.round((height * maxWidth) / width);
          width = maxWidth;
        }

        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);

        canvas.toBlob(
          (blob) => {
            if (blob) resolve(blob);
            else reject(new Error('Canvas image compression failed.'));
          },
          'image/jpeg',
          quality
        );
      };
    };
    reader.onerror = (error) => reject(error);
  });
}
Step 3: Offline Storage Engine (src/utils/offlineQueue.js)Manage local offline drafts using IndexedDB, auto-flushing records when connectivity resumes:JavaScriptimport { openDB } from 'idb';
import { supabase } from '../supabaseClient';

const DB_NAME = 'NileFoundOfflineDB';
const STORE_NAME = 'draft_reports';

export async function initDB() {
  return openDB(DB_NAME, 1, {
    upgrade(db) {
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
      }
    },
  });
}

export async function saveDraftOffline(reportData) {
  const db = await initDB();
  await db.add(STORE_NAME, { ...reportData, timestamp: Date.now() });
}

export async function syncOfflineDrafts() {
  if (!navigator.onLine) return;
  const db = await initDB();
  const drafts = await db.getAll(STORE_NAME);

  for (const draft of drafts) {
    try {
      const { id, timestamp, ...payload } = draft;
      const { error } = await supabase.from('items').insert([payload]);
      if (!error) {
        await db.delete(STORE_NAME, id);
      }
    } catch (err) {
      console.error('Failed to auto-sync draft report:', err);
    }
  }
}

window.addEventListener('online', syncOfflineDrafts);
