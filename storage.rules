rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMasterAdmin() {
      return request.auth != null
        && request.auth.uid == 'nFdIhTjOOqMqMG4y1KIT550Qf5m1'
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email == 'ayomide2289@gmail.com';
    }

    function isVerifiedNileUser() {
      return isMasterAdmin()
        || (
          request.auth != null
          && request.auth.token.keys().hasAll(['email_verified'])
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && request.auth.token.email.matches('^[^@]+@nileuniversity\\.edu\\.ng$')
        );
    }

    // Block all unmatched paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Item photo uploads restricted to verified users and their own UID path
    match /items/{userId}/{fileName} {
      // Verified Nile members can view item photos in the campus feed
      allow read: if isVerifiedNileUser();

      // Users can only create/update within their own path, max 5MB, strict image MIME types
      allow create, update: if isVerifiedNileUser()
        && request.auth.uid == userId
        && fileName.size() <= 128
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');

      // Deletion permitted only by the original uploader or the master admin
      allow delete: if isVerifiedNileUser()
        && (
          request.auth.uid == userId
          || isMasterAdmin()
        );
    }
  }
}
