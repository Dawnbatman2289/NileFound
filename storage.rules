rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default Deny: Block all unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Item photo uploads restricted to verified users and their own UID path
    match /items/{userId}/{fileName} {
      // Verified Nile members can view item photos in the campus feed
      allow read: if request.auth != null
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true;

      // Users can only upload to their own user path, max 5MB, strict image content types
      allow write: if request.auth != null
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp)$');

      // Deletion permitted only by the original uploader or the master admin
      allow delete: if request.auth != null
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && (
          request.auth.uid == userId
          || request.auth.token.email == 'ayomide2289@gmail.com'
        );
    }
  }
}
