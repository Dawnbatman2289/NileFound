rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn()
        && request.auth.token.keys().hasAll(['email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isMasterAdmin() {
      return isEmailVerified()
        && request.auth.uid == 'nFdIhTjOOqMqMG4y1KIT550Qf5m1';
    }

    function isNileEmail() {
      return isEmailVerified()
        && request.auth.token.email.lower().matches('^[^@\\s]+@nileuniversity\\.edu\\.ng$');
    }

    function isVerifiedMember() {
      return isMasterAdmin() || isNileEmail();
    }

    function isValidPhotoUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /items/{itemId}/{fileName} {
      allow read: if isVerifiedMember();
      allow create, update: if isVerifiedMember()
        && itemId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && fileName in ['photo.jpg', 'thumb.jpg']
        && isValidPhotoUpload()
        && request.resource.metadata != null
        && request.resource.metadata.authorId == request.auth.uid;
      allow delete: if isVerifiedMember()
        && (isMasterAdmin() || (resource != null && resource.metadata != null && resource.metadata.authorId == request.auth.uid));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
