{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Public campus lost or found notice without reporter PII.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 100 },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "category": { "type": "string", "enum": ["student_id", "phone_tech", "power_bank", "calculator", "flash_drive", "keys", "bag_backpack", "lab_coat_clothing", "books_notes", "other"] },
        "description": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "minLength": 2, "maxLength": 100 },
        "locationDetails": { "type": "string", "maxLength": 160 },
        "dateLostOrFound": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["open", "claim_requested", "verified", "returned", "expired"] },
        "holdingLocation": { "type": "string", "enum": ["finder_holding", "security_main_gate", "student_affairs_office", "faculty_officer", "library_desk"] },
        "authorId": { "type": "string", "maxLength": 128 },
        "verificationQuestion": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 140000 },
        "isSensitiveId": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "category", "description", "location", "status", "holdingLocation", "authorId", "createdAt", "updatedAt"]
    },
    "ItemPrivateDetails": {
      "title": "ItemPrivateDetails",
      "description": "Reporter identity and email kept off the public feed, accessible to the author, staff/admin, or an approved claimant.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorEmail": { "type": "string", "minLength": 3, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "authorId", "authorName", "authorEmail", "createdAt"]
    },
    "ItemSecret": {
      "title": "ItemSecret",
      "description": "Private verification answer set by the finder, accessible only to the author and campus staff/admins.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "expectedAnswer": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "authorId", "expectedAnswer", "createdAt"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Ownership claim metadata keyed deterministically as {itemId}_{claimantUid}.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "itemTitle": { "type": "string", "maxLength": 100 },
        "claimantId": { "type": "string", "maxLength": 128 },
        "finderId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "itemTitle", "claimantId", "finderId", "status", "createdAt", "updatedAt"]
    },
    "PrivateClaim": {
      "title": "PrivateClaim",
      "description": "Claimant contact info and verification answer restricted to the claimant, item finder, and campus staff/admins.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string", "maxLength": 128 },
        "claimId": { "type": "string", "maxLength": 128 },
        "claimantId": { "type": "string", "maxLength": 128 },
        "claimantName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "claimantEmail": { "type": "string", "minLength": 3, "maxLength": 100 },
        "submittedAnswer": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "claimId", "claimantId", "claimantName", "claimantEmail", "submittedAnswer", "createdAt"]
    },
    "Role": {
      "title": "Role",
      "description": "RBAC role document for campus administrators and security personnel.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "security", "student"] },
        "email": { "type": "string", "maxLength": 100 },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "email", "assignedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing campus affiliation and contact details.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "security", "admin"] },
        "matricNumber": { "type": "string", "maxLength": 20 },
        "department": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Delegated administrator configuration flags in /admins/{adminUid}.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "email": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enabled", "email", "updatedAt"]
    },
    "StaffInvite": {
      "title": "StaffInvite",
      "description": "Email-keyed staff role assignment before first sign-in.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "security", "student"] },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "assignedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Template-enforced, relationship-scoped campus notifications.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "fromUid": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["claim_received", "claim_approved", "claim_rejected", "match_alert", "item_returned", "admin_review"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "message": { "type": "string", "minLength": 2, "maxLength": 500 },
        "read": { "type": "boolean" },
        "itemId": { "type": "string", "maxLength": 128 },
        "sourceItemId": { "type": "string", "maxLength": 128 },
        "itemTitle": { "type": "string", "maxLength": 100 },
        "claimId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "fromUid", "type", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Public campus lost and found records readable only by verified Nile members."
    },
    "/items/{itemId}/private/{docId}": {
      "schema": "ItemPrivateDetails",
      "description": "Private reporter details accessible to the item author, campus staff/admin, or an approved claimant."
    },
    "/items/{itemId}/secrets/{secretId}": {
      "schema": "ItemSecret",
      "description": "Private expected verification answer for a found item, readable only by the finder and campus staff/admins."
    },
    "/items/{itemId}/privateClaims/{claimId}": {
      "schema": "PrivateClaim",
      "description": "Private claimant contact details and submitted answer readable by the claimant, item author, and campus staff/admins."
    },
    "/claims/{claimId}": {
      "schema": "Claim",
      "description": "Ownership claims readable only by the claimant, item finder, or campus staff/admins."
    },
    "/roles/{userId}": {
      "schema": "Role",
      "description": "Role document defining administrative or security personnel access."
    },
    "/staffInvites/{inviteEmail}": {
      "schema": "StaffInvite",
      "description": "Pending email-based staff role assignments."
    },
    "/admins/{adminUid}": {
      "schema": "AdminConfig",
      "description": "Delegated administrator access flags."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Recipient-scoped notifications."
    }
  }
}
